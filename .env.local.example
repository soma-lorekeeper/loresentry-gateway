# Copy to .env.local and replace every REPLACE_* value. Never use production credentials.
SPRING_PROFILES_ACTIVE=local
BFF_AUTH_BASE_URL=http://127.0.0.1:8001
BFF_CONTENT_BASE_URL=http://127.0.0.1:8002
BFF_GRAPH_BASE_URL=http://127.0.0.1:8003
BFF_CHAT_BASE_URL=http://127.0.0.1:8004
BFF_JWT_PUBLIC_KEY=/REPLACE_WITH_DEV_PUBLIC_KEY_PATH/auth-public.pem
BFF_JWT_KEY_ID=REPLACE_WITH_AUTH_KID
BFF_SESSION_REDIS_HOST=127.0.0.1
BFF_SESSION_REDIS_PORT=6379
BFF_SESSION_REDIS_USERNAME=bff
BFF_SESSION_REDIS_PASSWORD=REPLACE_WITH_DEV_BFF_READER_PASSWORD
BFF_SESSION_REDIS_TLS=false
